APP_NAME=YAPMITAI Backend
APP_ENV=production
API_V1_PREFIX=/api/v1
API_KEY=change-this-api-key

# Change this to your real domain after DNS points to the server.
CORS_ORIGINS=https://example.com

DATABASE_URL=mysql+aiomysql://yapmitai:change-this-db-password@mysql:3306/yapmitai?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
CHROMA_PERSIST_DIR=/app/storage/chroma
KNOWLEDGE_STORAGE_DIR=/app/storage/knowledge
GROWTH_REPORTS_DIR=/app/storage/growth-reports

# Optional external AI gateway settings.
AGENT_GATEWAY_URL=https://gateway.yapmitai.com/api/v1
AGENT_GATEWAY_TOKEN=
EXTERNAL_AI_BASE_URL=https://api.openai.com/v1
EXTERNAL_AI_API_KEY=

ENABLE_MOCK_FALLBACK=true
